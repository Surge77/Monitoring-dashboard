generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  metrics    Metric[]
  alertRules AlertRule[]

  @@map("users")
}

model Metric {
  id        String   @id @default(uuid())
  name      String
  unit      String?  @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  values     MetricValue[]
  alertRules AlertRule[]

  @@unique([userId, name])
  @@index([userId])
  @@index([name])
  @@map("metrics")
}

model MetricValue {
  id         String   @id @default(uuid())
  value      Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  metricId String @map("metric_id")
  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("metric_values")
}

model AlertRule {
  id        String   @id @default(uuid())
  operator  String
  threshold Float
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metricId String @map("metric_id")
  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events AlertEvent[]

  @@index([metricId])
  @@index([userId])
  @@index([isActive])
  @@map("alert_rules")
}

model AlertEvent {
  id          String   @id @default(uuid())
  metricValue Float    @map("metric_value")
  triggeredAt DateTime @default(now()) @map("triggered_at")

  alertRuleId String    @map("alert_rule_id")
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  @@index([alertRuleId, triggeredAt(sort: Desc)])
  @@index([triggeredAt(sort: Desc)])
  @@map("alert_events")
}
